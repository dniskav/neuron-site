---
import '../../styles/lab.css';
import '../../styles/equipo.css';
import { EXAM, KS, NTRAIN, TRAIN, kName } from '../../data/equipo';
import { newTeamCodeState, renderCodeHtml } from '../../data/equipoCode';
import { cmpPhrase, cmpRowInner } from '../ui/TeamBrainPanel';
import { computeTeamCmp } from '../../data/equipo';
import ActionButton from '../ui/ActionButton.astro';
import ActionRow from '../ui/ActionRow.astro';
import BrainMeter from '../ui/BrainMeter.astro';
import CodeBrainDock from '../ui/CodeBrainDock.astro';
import ColorDots from '../ui/ColorDots.astro';
import ColorPicker from '../ui/ColorPicker.astro';
import ExamStrip from '../ui/ExamStrip.astro';
import Jars from '../ui/Jars.astro';
import LearningCurve from '../ui/LearningCurve.astro';

const cmp = computeTeamCmp();
const codeHtml = renderCodeHtml(newTeamCodeState());

const jarTitles = Object.fromEntries(KS.map((k) => [k, kName(k)]));
---
<section id="equipo" aria-labelledby="t-equipo">
  <div class="ehead">
    <p class="eyebrow rv" style="--d:0">04 · en equipo</p>
    <h2 id="t-equipo" class="rv" style="--d:1">Ni claro ni oscuro</h2>
    <p class="sub rv" style="--d:2">En Enséñale, una neurona sola bastaba para claro y oscuro. Ahora la pregunta es otra: ¿es un color intermedio? Una neurona sola solo sabe hacer un corte recto y no puede quedarse con lo de en medio. ¿Y un equipo?</p>
  </div>
  <div class="elab">
    <div class="esets rv" style="--d:3">
      <p class="elabel">Tamaño del equipo</p>
      <ActionRow class="qteam" label="Cuántas neuronas tiene el equipo">
        <ActionButton id="qminus" aria-label="Quitar una neurona" disabled>− neurona</ActionButton>
        <output class="qcount" id="qcount" for="qminus qplus">{kName(1)}</output>
        <ActionButton id="qplus" aria-label="Añadir una neurona">+ neurona</ActionButton>
      </ActionRow>
      <ActionButton variant="go" id="qgo">Enséñale</ActionButton>
      <ActionButton variant="ghost" id="q0">Examinar sin enseñarle</ActionButton>
      <p class="elabel plab">{NTRAIN} colores para aprender</p>
      <ColorDots id="qdots" colors={TRAIN} label="Los 60 colores con los que aprende: un tercio oscuros, un tercio intermedios y un tercio claros" />
      <p class="elabel plab">O prueba un color tuyo</p>
      <ColorPicker prefix="q" />
      <p class="enote" id="qnote">Estas neuronas son de verdad: aprenden con <b>@dniskav/neuron</b>.</p>
    </div>
    <div class="emid rv" style="--d:4">
      <div class="ecv">
        <CodeBrainDock prefix="q" codeHtml={codeHtml} brainLabel="Lo que aprendió el equipo">
        <p class="bhead" id="qbhead">Todo lo que sabe cabe en 4 números</p>
        <p class="bnote" id="qbnote"></p>
        <div id="qbgroups"></div>
        <p class="bsec">Compáralos</p>
        <div class="crows" id="qcrows" role="group" aria-label="Lo aprendido con 1, 2 y 3 neuronas">
          {KS.map((k) => (
            <button type="button" class="crow" data-k={k} aria-pressed="false" title={`${kName(k)}: ${cmp[k].pct} % de aciertos`} aria-label={`${kName(k)}: ${cmp[k].pct} % de aciertos. Ver su código.`} set:html={cmpRowInner(k, cmp[k])}></button>
          ))}
        </div>
        <p class="bphrase" id="qbphrase">{cmpPhrase(cmp)}</p>
        <pre class="ccode" id="qbcode"></pre>
        </CodeBrainDock>
        <canvas id="qneuron" role="img" aria-label="Una red real: tres entradas, rojo, verde y azul, llegan a las neuronas del equipo; la última decide y tiene una sola salida, intermedio o no. Al aprender, después de responder llega la corrección y las conexiones cambian de grosor; en el examen solo responde."></canvas>
      </div>
      <p class="eleg" id="qeleg"><span id="qlg-a"><b>Aprender:</b> responde y la <i>corrigen</i>.</span> <span id="qlg-e"><b>Examen:</b> solo responde.</span><br />Más grueso = cuenta más · cortado = resta.<br />Cada neurona se llena con lo que le llega. Si pasa su línea dorada, se enciende y avisa a la siguiente.</p>
      <p class="estatus" id="qstatus">Equipo nuevo: {kName(1)} · pulsa «Enséñale»</p>
      <p class="exlab">Examen: 12 colores nuevos · ¿intermedio?</p>
      <ExamStrip id="qexam" colors={EXAM} />
    </div>
    <div class="eside rv" style="--d:5">
      <BrainMeter id="qmeter" label="Cerebro con una sección por neurona, vacío: todavía no han aprendido nada" />
      <p class="ephrase" id="qphrase"></p>
      <LearningCurve id="qcurve" class="ecurve" label="Curva de aprendizaje: cuánto se equivoca en los 60 colores, repaso a repaso" />
      <p class="ecap" id="qcap" aria-live="off"></p>
      <p class="jarlab">Comparar · neuronas y aciertos</p>
      <Jars id="qjars" keys={KS} titles={jarTitles} />
    </div>
  </div>
  <p class="vh" id="qlive" aria-live="polite"></p>
</section>

<script>
  import { startEquipo } from './equipoScreen';
  startEquipo();
</script>
