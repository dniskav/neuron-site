---
import '../../styles/lab.css';
import { ALL, EXAM, PICKER_CELLS, QUICK, SIZES, labelOf } from '../../data/ensenale';
import { newCodeState, renderCodeHtml } from '../../data/ensenaleCode';
import { comparePhrase, computeCmp, rowInner, rowTitle } from '../../data/ensenaleCompare';
import { css } from '../../viz/core/colors';

const cmp = computeCmp();
const phrase = comparePhrase(cmp);
const codeHtml = renderCodeHtml(newCodeState());
const sets = SIZES.map((k) => {
  const nl = ALL.slice(0, k).filter(labelOf).length;
  return { k, nl, nd: k - nl, dots: ALL.slice(0, k).map((c) => css(c)) };
});
const jarKeys = [0, ...SIZES];
const icoCopy = '<svg class="i-copy" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg><svg class="i-ok" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>';
const brainSvg = '<svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g id="bl"><path d="M12 5.2C12 3.9 10.9 3 9.7 3 8.1 3 7 4.1 7.2 5.5 5.5 5.8 4.4 7.1 4.4 8.7c0 .9.4 1.7 1 2.2-.7.6-1 1.5-1 2.4 0 1.6 1.2 2.9 2.7 3 .3 1.6 1.5 2.7 3.1 2.7 1 0 1.8-.7 1.8-1.7z"/><path d="M8.2 9.6c1.2.2 2.2.9 2.7 2M7.6 14.2c1.2-.2 2.2-.9 2.8-1.9"/></g><g transform="matrix(-1 0 0 1 24 0)"><path d="M12 5.2C12 3.9 10.9 3 9.7 3 8.1 3 7 4.1 7.2 5.5 5.5 5.8 4.4 7.1 4.4 8.7c0 .9.4 1.7 1 2.2-.7.6-1 1.5-1 2.4 0 1.6 1.2 2.9 2.7 3 .3 1.6 1.5 2.7 3.1 2.7 1 0 1.8-.7 1.8-1.7z"/><path d="M8.2 9.6c1.2.2 2.2.9 2.7 2M7.6 14.2c1.2-.2 2.2-.9 2.8-1.9"/></g></svg>';
const bars = [['255,96,84', 'rojo'], ['96,214,112', 'verde'], ['104,152,255', 'azul'], ['255,224,138', 'la línea']];
---
<section id="ensenale" aria-labelledby="t-ensenale">
  <div class="ehead">
    <p class="eyebrow rv" style="--d:0">03 · pruébalo</p>
    <h2 id="t-ensenale" class="rv" style="--d:1">Enséñale</h2>
    <p class="sub rv" style="--d:2">Elige cuántos colores le enseñas. Luego, un examen: ¿claro u oscuro?</p>
  </div>
  <div class="elab">
    <div class="esets rv" style="--d:3">
      <p class="elabel">Ejemplos para aprender</p>
      <div class="slist" id="slist" role="group" aria-label="Conjuntos de ejemplos">
        {sets.map((s) => (
          <button type="button" class="set" data-k={s.k} aria-pressed="false" aria-label={`${s.k} ejemplos: ${s.nl} claros y ${s.nd} oscuros`}>
            <span class="k"><b>{s.k}</b><small>ejemplos</small></span>
            <span class="cd" aria-hidden="true">{s.dots.map((c) => <i style={`background:${c}`}></i>)}</span>
            <span class="res" aria-hidden="true"></span>
          </button>
        ))}
      </div>
      <button class="e0" id="e0" type="button" aria-pressed="false">Examinar sin enseñarle</button>
      <p class="elabel plab">O prueba un color tuyo</p>
      <div class="pick" id="pick">
        <button class="pickc" id="pickc" type="button" title="Probar un color" aria-label="Probar un color" aria-haspopup="true" aria-expanded="false" aria-controls="ppop"><span class="pdot" id="pdot"></span></button>
        <div class="ppop" id="ppop" role="group" aria-label="Muestras de color para probar" hidden>
          {PICKER_CELLS.map((hex) => <button type="button" style={`background:${hex}`} tabindex="-1" aria-label={`Probar el color ${hex}`} data-hex={hex}></button>)}
        </div>
        <div class="pq" id="pq" role="group" aria-label="Colores rápidos para probar">
          {QUICK.map(([hex, name]) => <button type="button" style={`background:${hex}`} title={`Probar ${name}`} aria-label={`Probar ${name}`} data-hex={hex}></button>)}
        </div>
      </div>
      <p class="enote" id="enote">Esta neurona es de verdad: aprende con <b>@dniskav/neuron</b>.</p>
    </div>
    <div class="emid rv" style="--d:4">
      <div class="ecv">
        <div class="ecode" id="ecode">
          <button class="cbtn" id="cbtn" type="button" aria-label="Ver el código" title="Ver el código" aria-expanded="false" aria-controls="cpanel">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 7l-5 5 5 5"/><path d="M16 7l5 5-5 5"/><path d="M14 4l-4 16"/></svg>
          </button>
          <div class="cpanel" id="cpanel" role="region" aria-label="Código fuente de esta pantalla" tabindex="-1" hidden>
            <button class="ccopy" id="ccopy" type="button" aria-label="Copiar el código" title="Copiar el código" set:html={icoCopy}></button>
            <pre class="ccode" id="ccode" set:html={codeHtml}></pre>
          </div>
          <button class="cbtn bbtn" id="bbtn" type="button" aria-label="Ver lo que aprendió" title="Ver lo que aprendió" aria-expanded="false" aria-controls="bpanel" set:html={brainSvg}></button>
          <div class="cpanel bpanel" id="bpanel" role="region" aria-label="Lo que aprendió la neurona" tabindex="-1" hidden>
            <button class="ccopy" id="bcopy" type="button" aria-label="Copiar el código" title="Copiar el código" set:html={icoCopy}></button>
            <p class="bhead">Todo lo que sabe cabe en 4 números</p>
            <div class="bars" id="bars">
              {bars.map(([c, l]) => (
                <div class="brow" style={`--c:${c}`}><span class="bl">{l}</span><div class="bt"><i class="bz"></i><i class="bb"></i></div><span class="bv">–</span></div>
              ))}
            </div>
            <p class="bnote" id="bnote"></p>
            <p class="bcur" id="bcur"></p>
            <p class="bsec">Compáralos</p>
            <div class="crows" id="crows" role="group" aria-label="Lo aprendido con cada conjunto, de menos a más ejemplos">
              {jarKeys.map((k) => (
                <button type="button" class="crow" data-k={k} aria-pressed="false" title={rowTitle(k, cmp[k])} aria-label={`${rowTitle(k, cmp[k])}. Ver su código.`} set:html={rowInner(k, cmp[k])}></button>
              ))}
            </div>
            <p class="bphrase" id="bphrase">{phrase}</p>
            <pre class="ccode" id="bcode"></pre>
          </div>
        </div>
        <canvas id="eneuron" role="img" aria-label="Una neurona nueva con tres entradas, rojo, verde y azul, y una sola salida, claro u oscuro. Cada color se descompone en sus tres partes, viaja por las tres ramas y la neurona responde. Al aprender, después llega la corrección y las ramas cambian de grosor; en el examen solo responde."></canvas>
      </div>
      <p class="eleg" id="eleg"><span id="lg-a"><b>Aprender:</b> responde y la <i>corrigen</i>.</span> <span id="lg-e"><b>Examen:</b> solo responde.</span><br />Más grueso = cuenta más · cortado = resta.<br />Cada color llena la neurona. Si pasa la línea, dice claro. Aprender mueve la línea y cambia cuánto llena cada color.</p>
      <p class="estatus" id="estatus">Elige un conjunto de ejemplos para empezar</p>
      <p class="exlab">Examen: 12 colores nuevos</p>
      <div class="exam" id="exam" role="group" aria-label="Los 12 colores del examen">
        {EXAM.map((c, i) => <div class="ex" aria-label={`Color ${i + 1} del examen`}><i style={`background:${css(c)}`}></i><span></span></div>)}
      </div>
    </div>
    <div class="eside rv" style="--d:5">
      <div class="flask"><canvas id="eflask" role="img" aria-label="Frasco que se llena según los aciertos del examen"></canvas></div>
      <p class="ephrase" id="ephrase"></p>
      <p class="jarlab">Comparar · ejemplos y aciertos</p>
      <div class="jars" id="jars">
        {jarKeys.map((k) => (
          <div class="jar empty" data-k={k} title={k ? `${k} ejemplos` : 'Sin enseñarle'}>
            <div class="jb"><div class="liq" style="--h:0%;--q:0"></div></div><span class="jl">{k}</span><span class="jp">–</span>
          </div>
        ))}
      </div>
    </div>
  </div>
  <p class="vh" id="elive" aria-live="polite"></p>
</section>

<script>
  import { startEnsenale } from './ensenaleScreen';
  startEnsenale();
</script>
