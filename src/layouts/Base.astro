---
import '../styles/base.css';
import { SCREENS } from '../data/nav';

interface Props {
  title: string;
  description: string;
  lang?: 'es' | 'en';
}

const { title, description, lang = 'es' } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: '@dniskav/neuron',
  codeRepository: 'https://github.com/dniskav/neuron',
  programmingLanguage: 'TypeScript',
  license: 'https://opensource.org/licenses/MIT',
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="alternate" type="text/markdown" href="/llms.txt" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>

    <header>
      <a class="brand" href="#inicio" aria-label="Neuron, inicio"><i></i><span>@dniskav/neuron</span></a>
      <button class="guide-btn" id="guide-btn" type="button" aria-label="Mostrar la guía de esta pantalla" title="Guía de esta pantalla" hidden>?</button>
      <nav class="menu" aria-label="Principal">
        {SCREENS.map((s, i) => (
          <a href={`#${s.id}`}><span class="n">{String(i + 1).padStart(2, '0')}</span><span class="l">{s.label}</span></a>
        ))}
      </nav>
    </header>
    <nav class="dots" aria-label="Pantallas">
      {SCREENS.map((s) => <a href={`#${s.id}`} title={s.label} aria-label={s.label}></a>)}
    </nav>

    <main>
      <slot />
    </main>

    <script>
      import { getPager } from '../viz/Pager';
      import { startGuide } from '../viz/Guide';
      import { fitHeader } from '../viz/HeaderFit';
      getPager();
      startGuide();
      fitHeader();
    </script>
  </body>
</html>
